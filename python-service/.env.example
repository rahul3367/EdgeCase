# Get a free-tier key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Model names (override if Google changes free-tier availability)
GEMINI_CHAT_MODEL=Abc
GEMINI_EMBEDDING_MODEL=abc

# Where ChromaDB persists its local files
CHROMA_PERSIST_DIR=./chroma_data

# Chunking parameters
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# Top-k chunks retrieved per query
RETRIEVAL_TOP_K=6

# FastAPI server
PORT=8000
